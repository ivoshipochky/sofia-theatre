---
import Layout from '../../layouts/Layout.astro';
import { getDB } from '../../lib/db';

const { slug } = Astro.params;
const db = getDB(Astro.locals.runtime);

const theatre = await db.prepare('SELECT * FROM theatres WHERE slug = ?').bind(slug).first();

if (!theatre) {
  return Astro.redirect('/theatres');
}

const shows = await db.prepare(`
  SELECT s.*,
    COALESCE((SELECT ROUND(AVG(score), 1) FROM ratings WHERE show_id = s.id), 0) as avg_rating,
    COALESCE((SELECT COUNT(*) FROM ratings WHERE show_id = s.id), 0) as rating_count
  FROM shows s
  WHERE s.theatre_id = ?
  ORDER BY s.updated_at DESC
`).bind(theatre.id).all();
---

<Layout title={`${theatre.name} — Театър София`}>
  <nav class="text-sm text-zinc-500 mb-6">
    <a href="/theatres" class="hover:text-amber-400">Театри</a>
    <span class="mx-2">›</span>
    <span class="text-zinc-300">{theatre.name}</span>
  </nav>

  <h1 class="text-3xl font-bold mb-2">{theatre.name}</h1>
  {theatre.address && <p class="text-zinc-400 mb-2">{theatre.address}</p>}
  {theatre.website && (
    <a href={theatre.website as string} target="_blank" rel="noopener noreferrer"
      class="text-amber-400 hover:text-amber-300 text-sm">
      {theatre.website} →
    </a>
  )}

  <h2 class="text-2xl font-bold mt-10 mb-6">Представления ({shows.results.length})</h2>

  {shows.results.length === 0 ? (
    <p class="text-zinc-500">Няма представления от този театър все още.</p>
  ) : (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {shows.results.map((show: any) => (
        <a href={`/shows/${show.slug}`}
          class="bg-zinc-900 border border-zinc-800 rounded-lg overflow-hidden hover:border-amber-500/50 transition-colors group">
          {show.image_url && (
            <img src={show.image_url} alt={show.title}
              class="w-full h-48 object-cover group-hover:opacity-90 transition-opacity" />
          )}
          <div class="p-4">
            <div class="flex justify-between items-start mb-2">
              <h3 class="font-semibold">{show.title}</h3>
              {show.avg_rating > 0 && (
                <span class="text-amber-400 text-sm">★ {show.avg_rating}</span>
              )}
            </div>
            {show.genre && (
              <span class="inline-block mt-1 bg-zinc-800 text-zinc-300 px-2 py-0.5 rounded text-xs">
                {show.genre}
              </span>
            )}
          </div>
        </a>
      ))}
    </div>
  )}
</Layout>
